name: CI/CD Pipeline

on:
  push:
    tags:
      - 'v*' 

env:
  AWS_REGION: ${{ secrets.AWS_REGION }} 

jobs:
  build-and-deploy:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout code
        uses: actions/checkout@v3

      - name: Configure AWS credentials
        uses: aws-actions/configure-aws-credentials@v2
        with:
          aws-access-key-id: ${{ secrets.AWS_ACCESS_KEY_ID }}
          aws-secret-access-key: ${{ secrets.AWS_SECRET_ACCESS_KEY }}
          aws-region: ${{ env.AWS_REGION }}

      - name: Login to Amazon ECR
        id: login-ecr
        uses: aws-actions/amazon-ecr-login@v1

      - name: Set up Docker Buildx
        uses: docker/setup-buildx-action@v2

      - name: Build and push backend image
        uses: docker/build-push-action@v4
        with:
          context: ./backend
          push: true
          tags: ${{ steps.login-ecr.outputs.registry }}/check-statement-backend:${{ github.sha }},${{ steps.login-ecr.outputs.registry }}/check-statement-backend:latest
          cache-from: type=gha
          cache-to: type=gha,mode=max

      - name: Build and push frontend image
        uses: docker/build-push-action@v4
        with:
          context: ./frontend
          push: true
          tags: ${{ steps.login-ecr.outputs.registry }}/check-statement-frontend:${{ github.sha }},${{ steps.login-ecr.outputs.registry }}/check-statement-frontend:latest
          cache-from: type=gha
          cache-to: type=gha,mode=max

      - name: Update kube config
        run: aws eks update-kubeconfig --name check-statement-cluster --region ${{ env.AWS_REGION }}

      - name: Install kustomize
        run: |
          curl -s "https://raw.githubusercontent.com/kubernetes-sigs/kustomize/master/hack/install_kustomize.sh" | bash
          sudo mv kustomize /usr/local/bin/

      - name: Deploy to EKS
        run: |
          # Siapkan variabel lingkungan untuk substitusi
          export ECR_REGISTRY=${{ steps.login-ecr.outputs.registry }}
          export GOOGLE_API_KEY_BASE64=$(echo -n "${{ secrets.GOOGLE_API_KEY }}" | base64)
          
          # Buat namespace jika belum ada
          kubectl apply -f k8/namespace.yaml
          
          # Update image di deployment
          cd k8
          kustomize edit set image ${ECR_REGISTRY}/check-statement-backend:latest=${ECR_REGISTRY}/check-statement-backend:${{ github.sha }}
          kustomize edit set image ${ECR_REGISTRY}/check-statement-frontend:latest=${ECR_REGISTRY}/check-statement-frontend:${{ github.sha }}
          
          # Terapkan manifest dengan kustomize
          kustomize build | envsubst | kubectl apply -f -
          
          # Verifikasi deployment
          kubectl rollout status deployment/backend-deployment -n check-statement
          kubectl rollout status deployment/frontend-deployment -n check-statement

      - name: Get Load Balancer URL
        if: success()
        run: |
          echo "Aplikasi berhasil di-deploy!"
          echo "URL Frontend Load Balancer:"
          kubectl get service frontend-service -n check-statement -o jsonpath="{.status.loadBalancer.ingress[0].hostname}"
